opam-version: "2.0"
name: "rocq-galette"
version: "0.1.0"
synopsis: "Rocq port of the CakeML Pancake compiler and its correctness theorems (RISC-V and ARMv8 backends)"
description: "Rocq port of the Pancake compiler and its correctness theorems from HOL4, for the RISC-V and ARMv8 (AArch64) backends."
maintainer: "Flamingo Ponderado - Unipessoal LDA <hello@flamingoponderado.com>"
authors: ["CakeML contributors" "HOL4 contributors" "Galette contributors"]
license: "BSD-3-Clause"
homepage: "https://github.com/flamingoponderado/galette"
bug-reports: "https://github.com/flamingoponderado/galette/issues"
doc: "https://github.com/flamingoponderado/galette#readme"
dev-repo: "git+https://github.com/flamingoponderado/galette.git"
depends: [
  "dune" {>= "3.24"}
  "rocq-prover" {>= "9.3.0" & < "9.4~"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
tags: [
  "logpath:Galette"
  "keyword:CakeML"
  "keyword:Pancake"
  "keyword:RISC-V"
  "keyword:ARMv8"
]
